        },
        "containerId": {
          "type": "string",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "maxLength": 128
        },
        "chemicalName": {
          "type": "string",
          "maxLength": 200
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "locationCode": {
          "type": "string",
          "maxLength": 120
        },
        "laboratoryId": {
          "type": "string",
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "requestedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "requestedByName": {
          "type": "string",
          "maxLength": 120
        },
        "requestedByRole": {
          "type": "string"
        },
        "requestedAt": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["REQUESTED", "APPROVED", "DISPOSED", "REJECTED"]
        }
      },
      "required": [
        "disposalId",
        "containerId",
        "productId",
        "chemicalName",
        "quantity",
        "unit",
        "locationCode",
        "laboratoryId",
        "reason",
        "requestedByUid",
        "requestedByName",
        "requestedByRole",
        "requestedAt",
        "status"
      ]
    },
    "PurchaseWorkflowItem": {
      "title": "PurchaseWorkflowItem",
      "description": "Reagent purchase request and receiving workflow tracking.",
      "type": "object",
      "properties": {
        "purchaseId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chemicalName": {
          "type": "string",
          "maxLength": 200
        },
        "casNumber": {
          "type": "string",
          "maxLength": 32
        },
        "formula": {
          "type": "string",
          "maxLength": 64
        },
        "requestedQuantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "supplier": {
          "type": "string",
          "maxLength": 120
        },
        "laboratoryId": {
          "type": "string",
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "requestedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "requestedByName": {
          "type": "string",
          "maxLength": 120
        },
        "requestedByRole": {
          "type": "string"
        },
        "requestedAt": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["REQUESTED", "APPROVED", "ORDERED", "RECEIVED"]
        }
      },
      "required": [
        "purchaseId",
        "chemicalName",
        "casNumber",
        "formula",
        "requestedQuantity",
        "unit",
        "supplier",
        "laboratoryId",
        "reason",
        "requestedByUid",
        "requestedByName",
        "requestedByRole",
        "requestedAt",
        "status"
      ]
    },
    "StockRuptureRequest": {
      "title": "StockRuptureRequest",
      "description": "Stock rupture incident report and resolution tracking.",
      "type": "object",
      "properties": {
        "ruptureId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "containerId": {
          "type": "string",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "maxLength": 128
        },
        "chemicalName": {
          "type": "string",
          "maxLength": 200
        },
        "casNumber": {
          "type": "string",
          "maxLength": 32
        },
        "formula": {
          "type": "string",
          "maxLength": 64
        },
        "laboratoryId": {
          "type": "string",
          "maxLength": 128
        },
        "locationCode": {
          "type": "string",
          "maxLength": 120
        },
        "currentInventoryQuantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "currentInventoryStatus": {
          "type": "string"
        },
        "reportedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "reportedByName": {
          "type": "string",
          "maxLength": 120
        },
