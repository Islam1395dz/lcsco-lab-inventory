    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Laboratory system configuration item.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["settingId"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles containing role, assigned laboratories, and account status."
    },
    "/laboratories/{labId}": {
      "schema": { "$ref": "#/entities/Laboratory" },
      "description": "Registered research laboratories."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Chemical catalog items with CAS, formula, hazard classes, and stock thresholds."
    },
    "/containers/{containerId}": {
      "schema": { "$ref": "#/entities/Container" },
      "description": "Physical chemical containers tracked by barcode/QR ID with real-time stock and location."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Strictly append-only, immutable audit trail of all inventory actions."
    },
    "/physicalLocations/{locationId}": {
      "schema": { "$ref": "#/entities/PhysicalLocation" },
      "description": "Physical storage cabinet configs and shelf layouts."
    },
    "/adjustmentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/StockAdjustmentRequest" },
      "description": "Stock count correction requests."
    },
    "/disposalRequests/{disposalId}": {
      "schema": { "$ref": "#/entities/DisposalWorkflowItem" },
      "description": "Chemical disposal requests."
    },
    "/purchaseRequests/{purchaseId}": {
      "schema": { "$ref": "#/entities/PurchaseWorkflowItem" },
      "description": "Chemical purchase requests."
    },
    "/stockRuptureRequests/{ruptureId}": {
      "schema": { "$ref": "#/entities/StockRuptureRequest" },
      "description": "Stock rupture incident reports."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Role-targeted notifications."
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "System and lab floor plan configuration."
    }
  }
}
