    "AppNotification": {
      "title": "AppNotification",
      "description": "Role-targeted alert or task notification.",
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message": {
          "type": "string",
