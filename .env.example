# GEMINI_API_KEY: Required for the server-side document-import extraction
# (/api/inventory/import-document). Never expose this key to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (comma separated list allowed).
# Used to build the cross-origin allowlist for /api/* requests.
APP_URL="MY_APP_URL"

# Firebase Admin SDK credentials for ID-token verification on the server.
# Either point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key
# (do NOT commit the file), or — simplest on Render — paste the entire JSON
# document into the FIREBASE_SERVICE_ACCOUNT_JSON environment variable.
GOOGLE_APPLICATION_CREDENTIALS="/secure/path/service-account.json"
FIREBASE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",\"project_id\":\"lcsco-lab-inventory\",...}"

# Welcome emails (temporary passwords) sent when the Director provisions a new
# member account. Transport priority: Resend first, then SMTP. If neither is
# configured, account creation still works but no email is sent — the temporary
# password is shown once to the Director instead.
#
# RESEND_API_KEY: from resend.com → API Keys. Plain HTTP, no extra dependency.
# NOTE: Resend's shared "onboarding@resend.dev" sender only delivers to the
# Resend account's own address. To email arbitrary members, verify a domain at
# resend.com/domains and set MAIL_FROM to an address on it.
RESEND_API_KEY="re_MY_RESEND_KEY"

# Alternative SMTP transport (used only when RESEND_API_KEY is empty).
# Example for Gmail: create an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification) and use it as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="lab.director@gmail.com"
SMTP_PASS="MY_GMAIL_APP_PASSWORD"

# Sender identity for both transports.
MAIL_FROM="LCSCO Inventory <onboarding@resend.dev>"

# Optional: server port (default 3000).
# PORT=3000

# Optional: set to "production" when serving the built SPA from this server.
# NODE_ENV=production
