# GEMINI_API_KEY: Required for the server-side document-import extraction
# (/api/inventory/import-document). Never expose this key to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (comma separated list allowed).
# Used to build the cross-origin allowlist for /api/* requests.
APP_URL="MY_APP_URL"

# Firebase Admin SDK credentials for ID-token verification on the server.
# Either point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key
# (do NOT commit the file), or — simplest on Render — paste the entire JSON
# document into the FIREBASE_SERVICE_ACCOUNT_JSON environment variable.
GOOGLE_APPLICATION_CREDENTIALS="/secure/path/service-account.json"
FIREBASE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",\"project_id\":\"lcsco-lab-inventory\",...}"

# Google Apps Script mail relay (recommended on Render Free).
# A tiny Apps Script web app sends mail through a Gmail account over HTTPS,
# because Render Free blocks outbound SMTP ports. See docs/apps-script-mail-relay.js
# for the script and deployment steps.
APPS_SCRIPT_MAIL_URL="https://script.google.com/macros/s/MY_DEPLOYMENT_ID/exec"
APPS_SCRIPT_MAIL_SECRET="a-long-random-shared-secret"

# Welcome emails (temporary passwords) sent when the Director provisions a new
# member account. Transport priority: Apps Script relay, then Resend, then Brevo,
# then SMTP (override with MAIL_TRANSPORT below). If none is configured, account
# creation still works but no email is sent — the temporary password is shown
# once to the Director instead.
#
# The HTTP transports work everywhere, including hosts that block outbound
# SMTP (Render Free instances refuse ports 25/465/587 outright).
#
# RESEND_API_KEY: from resend.com → API Keys. Plain HTTP, no extra dependency.
# NOTE: Resend's shared "onboarding@resend.dev" sender only delivers to the
# Resend account's own address. To email arbitrary members, verify a domain at
# resend.com/domains and set MAIL_FROM to an address on it.
RESEND_API_KEY="re_MY_RESEND_KEY"

# BREVO_API_KEY: from app.brevo.com → SMTP & API → API Keys. Sends over HTTPS.
# No domain required: add and confirm a sender address under
# "Senders, Domains & Dedicated IPs", then set MAIL_FROM to that address.
BREVO_API_KEY="xkeysib-MY_BREVO_KEY"

# Alternative SMTP transport, e.g. Gmail — delivers to ANY recipient, no domain
# to verify, but unreachable from hosts that block SMTP ports (Render Free).
# Create an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account) and use it as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="lab.director@gmail.com"
SMTP_PASS="MY_GMAIL_APP_PASSWORD"

# MAIL_TRANSPORT: force a transport when several are configured ("appsscript",
# "resend", "brevo" or "smtp"). Without it, the Apps Script relay wins, then
# Resend, then Brevo, then SMTP.
# MAIL_TRANSPORT="appsscript"

# Sender identity. Must be a sender the chosen provider accepts: a verified
# domain on Resend, a verified sender address on Brevo, or the authenticated
# mailbox (or a verified alias) on SMTP.
MAIL_FROM="LCSCO Inventory <onboarding@resend.dev>"

# Optional: server port (default 3000).
# PORT=3000

# Optional: set to "production" when serving the built SPA from this server.
# NODE_ENV=production
