rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL SAFETY NET: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRIMITIVE HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * A verified identity is any signed-in user whose email has been verified.
     * Anonymous sessions are NEVER treated as verified identities.
     */
    function isVerified() {
      return isSignedIn() &&
        request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * Role comes from the verified ID token custom claim.
     * The user document role is only trusted when no claim has been provisioned
     * yet (migration fallback) and the identity is verified.
     * NOTE: accessing a missing key on the token map raises an error in the
     * rules engine, so every access is guarded with an `in` membership test.
     */
    function tokenRole() {
      return isSignedIn() && ('role' in request.auth.token) && request.auth.token.role is string
        ? request.auth.token.role
        : (userDocExists() && isVerified() ? getUserRole() : '');
    }

    /** One-time bootstrap account, resolved from a verified Firebase Auth email. */
    function isBootstrappedAdmin() {
      return isVerified() &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'director@lcsco.dz';
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        tokenRole() == 'ADMIN';
    }

    function isAdminOrProf() {
      return isBootstrappedAdmin() ||
        tokenRole() == 'ADMIN' ||
        tokenRole() == 'PROFESSOR';
    }

    function isTechOrAbove() {
      return isBootstrappedAdmin() ||
        tokenRole() == 'ADMIN' ||
        tokenRole() == 'PROFESSOR' ||
        tokenRole() == 'TECHNICIAN';
    }

    function isActiveLabMember() {
      return isBootstrappedAdmin() ||
        tokenRole() == 'ADMIN' ||
        tokenRole() == 'PROFESSOR' ||
        tokenRole() == 'TECHNICIAN' ||
        tokenRole() == 'PHD_STUDENT' ||
        tokenRole() == 'STUDENT_RESEARCHER';
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS
    // =========================================================================
    function isValidUnit(u) {
      return u is string && (u == 'g' || u == 'kg' || u == 'mg' || u == 'mL' || u == 'L');
    }

    function isValidContainerStatus(s) {
      return s is string && (
        s == 'NORMAL' ||
        s == 'LOW_STOCK' ||
        s == 'NEARLY_EMPTY' ||
        s == 'NEEDS_IDENTIFICATION' ||
        s == 'QUARANTINED' ||
        s == 'DISPOSAL_REQUIRED' ||
        s == 'EXPIRED'
      );
    }

    // NOTE:
    //  - Credentials (password / mustChangePassword) are NO LONGER part of this
    //    schema. Accounts and password resets are owned by Firebase Auth.
    //  - The remaining personal data (fullName, email, role, laboratoryIds) is
    //    minimum required for role-based notification routing and audit logs.
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'laboratoryIds', 'status', 'createdAt', 'lastLogin']) &&
        data.keys().hasOnly(['uid', 'fullName', 'email', 'role', 'laboratoryIds', 'status', 'createdAt', 'lastLogin', 'isDemoAccount', 'avatarUrl']) &&
        isValidId(data.uid) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.role is string && (
          data.role == 'ADMIN' ||
          data.role == 'PROFESSOR' ||
          data.role == 'TECHNICIAN' ||
          data.role == 'PHD_STUDENT' ||
          data.role == 'STUDENT_RESEARCHER' ||
          data.role == 'GUEST'
        ) &&
        data.laboratoryIds is list && data.laboratoryIds.size() <= 20 &&
        (data.laboratoryIds.size() == 0 || (data.laboratoryIds[0] is string && data.laboratoryIds[0].size() <= 128)) &&
        data.status is string && (data.status == 'ACTIVE' || data.status == 'PENDING' || data.status == 'DEACTIVATED') &&
        (!('isDemoAccount' in data) || data.isDemoAccount is bool);
    }

    function isValidLaboratory(data) {
      return data.keys().hasAll(['labId', 'name', 'createdAt']) &&
        data.keys().hasOnly(['labId', 'name', 'createdAt']) &&
        isValidId(data.labId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'productId', 'chemicalName', 'casNumber', 'formula', 'molecularWeight',
          'hazardClass', 'storageRequirements', 'defaultUnit', 'minimumStock',
          'reorderLevel', 'sdsUrl'
        ]) &&
        isValidId(data.productId) &&
        data.chemicalName is string && data.chemicalName.size() >= 1 && data.chemicalName.size() <= 200 &&
        data.casNumber is string && data.casNumber.size() >= 1 && data.casNumber.size() <= 32 &&
        data.formula is string && data.formula.size() >= 1 && data.formula.size() <= 64 &&
        data.molecularWeight is number && data.molecularWeight >= 0 &&
        data.hazardClass is list && data.hazardClass.size() <= 10 &&
        (data.hazardClass.size() == 0 || (data.hazardClass[0] is string && data.hazardClass[0].size() <= 100)) &&
        data.storageRequirements is string && data.storageRequirements.size() >= 1 && data.storageRequirements.size() <= 200 &&
        isValidUnit(data.defaultUnit) &&
        data.minimumStock is number && data.minimumStock >= 0 &&
        data.reorderLevel is number && data.reorderLevel >= 0 &&
        data.sdsUrl is string && data.sdsUrl.size() <= 500;
    }

    function isValidLocationMap(loc) {
      return loc is map &&
        loc.keys().hasAll(['building', 'room', 'unit', 'shelf', 'position', 'code']) &&
        loc.building is string && loc.building.size() >= 1 && loc.building.size() <= 80 &&
        loc.room is string && loc.room.size() >= 1 && loc.room.size() <= 80 &&
        loc.unit is string && loc.unit.size() >= 1 && loc.unit.size() <= 80 &&
        loc.shelf is string && loc.shelf.size() >= 1 && loc.shelf.size() <= 80 &&
        loc.position is string && loc.position.size() >= 1 && loc.position.size() <= 80 &&
        loc.code is string && loc.code.size() >= 1 && loc.code.size() <= 120;
    }

    function isValidContainer(data) {
      return data.keys().hasAll([
          'containerId', 'productId', 'laboratoryId', 'initialQuantity', 'currentQuantity',
          'unit', 'location', 'storageCondition', 'status', 'lotNumber',
          'supplier', 'expiryDate', 'createdBy'
        ]) &&
        isValidId(data.containerId) &&
        isValidId(data.productId) &&
        isValidId(data.laboratoryId) &&
        data.initialQuantity is number && data.initialQuantity > 0 &&
        data.currentQuantity is number && data.currentQuantity >= 0 &&
        isValidUnit(data.unit) &&
        isValidLocationMap(data.location) &&
        data.storageCondition is string && data.storageCondition.size() >= 1 && data.storageCondition.size() <= 200 &&
        isValidContainerStatus(data.status) &&
        data.lotNumber is string && data.lotNumber.size() >= 1 && data.lotNumber.size() <= 80 &&
        data.supplier is string && data.supplier.size() >= 1 && data.supplier.size() <= 120 &&
        data.expiryDate is string && data.expiryDate.size() >= 4 && data.expiryDate.size() <= 40 &&
        isValidId(data.createdBy);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'transactionId', 'type', 'userId', 'userName',
          'laboratoryId', 'containerId', 'productId', 'quantityChange',
          'quantityBefore', 'quantityAfter', 'unit', 'oldLocation',
          'newLocation', 'oldStatus', 'newStatus', 'reason', 'timestamp'
        ]) &&
        isValidId(data.transactionId) &&
        data.type is string && (
          data.type == 'WITHDRAWAL' ||
          data.type == 'ADDITION' ||
          data.type == 'TRANSFER' ||
          data.type == 'STATUS_CHANGE' ||
          data.type == 'CORRECTION'
        ) &&
        data.timestamp == request.time &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        isValidId(data.laboratoryId) &&
        isValidId(data.containerId) &&
        isValidId(data.productId) &&
        data.quantityChange is number &&
        data.quantityBefore is number && data.quantityBefore >= 0 &&
        data.quantityAfter is number && data.quantityAfter >= 0 &&
        data.quantityBefore + data.quantityChange == data.quantityAfter &&
        isValidUnit(data.unit) &&
        data.oldLocation is string && data.oldLocation.size() >= 1 && data.oldLocation.size() <= 120 &&
        data.newLocation is string && data.newLocation.size() >= 1 && data.newLocation.size() <= 120 &&
        isValidContainerStatus(data.oldStatus) &&
        isValidContainerStatus(data.newStatus) &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500;
    }

    function isValidPhysicalLocation(data) {
      return data.keys().hasAll(['id', 'room', 'cabinet', 'cabinetLabel', 'storageClassification', 'sides', 'shelves', 'positions']) &&
        isValidId(data.id) &&
        data.room is string && data.room.size() >= 1 && data.room.size() <= 80 &&
        data.cabinet is string && data.cabinet.size() >= 1 && data.cabinet.size() <= 80 &&
        data.cabinetLabel is string && data.cabinetLabel.size() >= 1 && data.cabinetLabel.size() <= 150 &&
        data.storageClassification is string && data.storageClassification.size() >= 1 && data.storageClassification.size() <= 100 &&
        data.sides is list && data.sides.size() <= 10 &&
        data.shelves is list && data.shelves.size() <= 50 &&
        data.positions is list && data.positions.size() <= 100;
    }

    function isValidAdjustmentRequest(data) {
      return data.keys().hasAll([
          'requestId', 'containerId', 'productId', 'chemicalName', 'laboratoryId',
          'previousQuantity', 'newQuantity', 'difference', 'unit', 'reason',
          'requestedByUid', 'requestedByName', 'requestedByRole', 'requestedAt', 'status'
        ]) &&
        isValidId(data.requestId) &&
        isValidId(data.containerId) &&
        isValidId(data.productId) &&
        data.chemicalName is string && data.chemicalName.size() >= 1 && data.chemicalName.size() <= 200 &&
        isValidId(data.laboratoryId) &&
        data.previousQuantity is number && data.previousQuantity >= 0 &&
        data.newQuantity is number && data.newQuantity >= 0 &&
        data.previousQuantity + data.difference == data.newQuantity &&
        isValidUnit(data.unit) &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
        isValidId(data.requestedByUid) &&
        data.requestedByName is string && data.requestedByName.size() >= 1 && data.requestedByName.size() <= 120 &&
        data.status is string && (data.status == 'PENDING' || data.status == 'APPROVED' || data.status == 'REJECTED');
    }

    function isValidDisposalRequest(data) {
      return data.keys().hasAll([
          'disposalId', 'containerId', 'productId', 'chemicalName', 'quantity',
          'unit', 'locationCode', 'laboratoryId', 'reason', 'requestedByUid',
          'requestedByName', 'requestedByRole', 'requestedAt', 'status'
        ]) &&
        isValidId(data.disposalId) &&
        isValidId(data.containerId) &&
        isValidId(data.productId) &&
        data.chemicalName is string && data.chemicalName.size() >= 1 && data.chemicalName.size() <= 200 &&
        data.quantity is number && data.quantity > 0 &&
        isValidUnit(data.unit) &&
        data.locationCode is string && data.locationCode.size() >= 1 && data.locationCode.size() <= 120 &&
        isValidId(data.laboratoryId) &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
        isValidId(data.requestedByUid) &&
        data.requestedByName is string && data.requestedByName.size() >= 1 && data.requestedByName.size() <= 120 &&
        data.status is string && (data.status == 'REQUESTED' || data.status == 'APPROVED' || data.status == 'DISPOSED' || data.status == 'REJECTED');
    }

    function isValidPurchaseRequest(data) {
      return data.keys().hasAll([
          'purchaseId', 'chemicalName', 'casNumber', 'formula', 'requestedQuantity',
          'unit', 'supplier', 'laboratoryId', 'reason', 'requestedByUid',
          'requestedByName', 'requestedByRole', 'requestedAt', 'status'
        ]) &&
        isValidId(data.purchaseId) &&
        data.chemicalName is string && data.chemicalName.size() >= 1 && data.chemicalName.size() <= 200 &&
        data.casNumber is string && data.casNumber.size() >= 1 && data.casNumber.size() <= 32 &&
        data.formula is string && data.formula.size() >= 1 && data.formula.size() <= 64 &&
        data.requestedQuantity is number && data.requestedQuantity > 0 &&
        isValidUnit(data.unit) &&
        data.supplier is string && data.supplier.size() >= 1 && data.supplier.size() <= 120 &&
        isValidId(data.laboratoryId) &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
        isValidId(data.requestedByUid) &&
        data.requestedByName is string && data.requestedByName.size() >= 1 && data.requestedByName.size() <= 120 &&
        data.status is string && (data.status == 'REQUESTED' || data.status == 'APPROVED' || data.status == 'ORDERED' || data.status == 'RECEIVED');
    }

    function isValidStockRuptureRequest(data) {
      return data.keys().hasAll([
          'ruptureId', 'containerId', 'productId', 'chemicalName', 'casNumber',
          'formula', 'laboratoryId', 'locationCode', 'currentInventoryQuantity',
          'unit', 'currentInventoryStatus', 'reportedByUid', 'reportedByName',
          'reportedByRole', 'reportedAt', 'priority', 'status', 'reportCount', 'reporters'
        ]) &&
        isValidId(data.ruptureId) &&
        isValidId(data.containerId) &&
        isValidId(data.productId) &&
        data.chemicalName is string && data.chemicalName.size() >= 1 && data.chemicalName.size() <= 200 &&
        data.casNumber is string && data.casNumber.size() >= 1 && data.casNumber.size() <= 32 &&
        data.formula is string && data.formula.size() >= 1 && data.formula.size() <= 64 &&
        isValidId(data.laboratoryId) &&
        data.locationCode is string && data.locationCode.size() >= 1 && data.locationCode.size() <= 120 &&
        data.currentInventoryQuantity is number &&
        isValidUnit(data.unit) &&
        isValidId(data.reportedByUid) &&
        data.reportedByName is string && data.reportedByName.size() >= 1 && data.reportedByName.size() <= 120 &&
        data.priority is string && (data.priority == 'LOW' || data.priority == 'MEDIUM' || data.priority == 'HIGH' || data.priority == 'CRITICAL') &&
        data.status is string && (data.status == 'REPORTED' || data.status == 'UNDER_REVIEW' || data.status == 'CONFIRMED' || data.status == 'RESOLVED' || data.status == 'REJECTED') &&
        data.reportCount is number && data.reportCount >= 1 &&
        data.reporters is list && data.reporters.size() <= 50;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'notificationId', 'type', 'title', 'message', 'priority',
          'recipientUserId', 'createdByUserId', 'createdAt', 'isRead', 'isResolved'
        ]) &&
        isValidId(data.notificationId) &&
        data.type is string && data.type.size() >= 1 && data.type.size() <= 64 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.priority is string && (data.priority == 'LOW' || data.priority == 'MEDIUM' || data.priority == 'HIGH' || data.priority == 'CRITICAL') &&
        isValidId(data.recipientUserId) &&
        isValidId(data.createdByUserId) &&
        data.isRead is bool &&
        data.isResolved is bool;
    }

    // =========================================================================
    // COLLECTION: users/{uid}
    // =========================================================================
    match /users/{uid} {
      // PII isolation: a user may read their own document; staff roles may
      // list members needed for notification routing and administration.
      allow get: if isSignedIn() && (isOwner(uid) || isAdminOrProf() || isActiveLabMember());
      allow list: if isSignedIn() && isActiveLabMember();

      allow create: if isVerified() &&
        isValidId(uid) &&
        isValidUser(incoming()) &&
        incoming().uid == uid &&
        (
          isBootstrappedAdmin() ||
          isAdmin()
        );

      allow update: if isVerified() &&
        isValidId(uid) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        (
          (isOwner(uid) &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'lastLogin', 'laboratoryIds', 'avatarUrl'])
          ) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'laboratoryIds', 'status', 'lastLogin', 'isDemoAccount', 'avatarUrl'])
          )
        );

      allow delete: if isVerified() && isValidId(uid) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: laboratories/{labId}
    // =========================================================================
    match /laboratories/{labId} {
      allow get: if isSignedIn() && isValidId(labId) && existing().name.size() >= 1;
      allow list: if isSignedIn() && existing().name.size() >= 1;

      allow create: if isVerified() &&
        isValidId(labId) &&
        isValidLaboratory(incoming()) &&
        incoming().labId == labId &&
        isTechOrAbove();

      allow update: if isVerified() &&
        isValidId(labId) &&
        isValidLaboratory(incoming()) &&
        incoming().labId == existing().labId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
        isAdminOrProf();

      allow delete: if isVerified() && isValidId(labId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: products/{productId}
    // =========================================================================
    match /products/{productId} {
      allow get: if isSignedIn() && existing().molecularWeight >= 0;
      allow list: if isSignedIn() && existing().molecularWeight >= 0;

      allow create: if isVerified() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().productId == productId &&
        isTechOrAbove();

      allow update: if isVerified() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().productId == existing().productId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'chemicalName', 'casNumber', 'formula', 'molecularWeight',
          'hazardClass', 'storageRequirements', 'defaultUnit',
          'minimumStock', 'reorderLevel', 'sdsUrl', 'updatedAt',
          'chemicalClassification', 'storageClassification', 'isDemoData'
        ]) &&
        isTechOrAbove();

      allow delete: if isVerified() && isValidId(productId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: containers/{containerId}
    // =========================================================================
    match /containers/{containerId} {
      allow get: if isSignedIn() && existing().currentQuantity >= 0;
      allow list: if isSignedIn() && existing().currentQuantity >= 0;

      allow create: if isVerified() &&
        isValidId(containerId) &&
        isValidContainer(incoming()) &&
        incoming().containerId == containerId &&
        isTechOrAbove() &&
        incoming().createdBy == request.auth.uid &&
        exists(/databases/$(database)/documents/products/$(incoming().productId)) &&
        exists(/databases/$(database)/documents/laboratories/$(incoming().laboratoryId));

      allow update: if isVerified() &&
        isValidId(containerId) &&
        isValidContainer(incoming()) &&
        incoming().containerId == existing().containerId &&
        incoming().productId == existing().productId &&
        incoming().initialQuantity == existing().initialQuantity &&
        incoming().unit == existing().unit &&
        incoming().createdBy == existing().createdBy &&
        (existing().status != 'DISPOSAL_REQUIRED' || isAdminOrProf()) &&
        (
          isAdminOrProf() ||
          (isActiveLabMember() &&
            existing().status != 'NEEDS_IDENTIFICATION' &&
            existing().status != 'QUARANTINED' &&
            existing().status != 'DISPOSAL_REQUIRED' &&
            existing().status != 'EXPIRED' &&
            (incoming().status == 'NORMAL' || incoming().status == 'LOW_STOCK' || incoming().status == 'NEARLY_EMPTY') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['currentQuantity', 'status', 'updatedAt'])
          ) ||
          (isActiveLabMember() &&
            (incoming().status == 'NEEDS_IDENTIFICATION' || incoming().status == 'QUARANTINED') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (isTechOrAbove() &&
            incoming().status != 'DISPOSAL_REQUIRED' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentQuantity', 'location', 'storageCondition', 'status',
              'laboratoryId', 'lotNumber', 'supplier', 'expiryDate',
              'chemicalClassification', 'storageClassification', 'isDemoData', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerified() && isValidId(containerId) && (isAdmin() || isTechOrAbove());
    }

    // =========================================================================
    // COLLECTION: transactions/{transactionId} (STRICTLY APPEND-ONLY AUDIT LOG)
    // =========================================================================
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && existing().quantityBefore >= 0;
      allow list: if isSignedIn() && existing().quantityBefore >= 0;

      allow create: if isVerified() &&
        isValidId(transactionId) &&
        isValidTransaction(incoming()) &&
        incoming().transactionId == transactionId &&
        incoming().userId == request.auth.uid &&
        isActiveLabMember() &&
        exists(/databases/$(database)/documents/containers/$(incoming().containerId)) &&
        exists(/databases/$(database)/documents/products/$(incoming().productId));

      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // COLLECTION: physicalLocations/{locationId}
    // =========================================================================
    match /physicalLocations/{locationId} {
      allow get: if isSignedIn() && isValidId(locationId);
      allow list: if isSignedIn();

      allow create: if isVerified() &&
        isValidId(locationId) &&
        isValidPhysicalLocation(incoming()) &&
        incoming().id == locationId &&
        isTechOrAbove();

      allow update: if isVerified() &&
        isValidId(locationId) &&
        isValidPhysicalLocation(incoming()) &&
        incoming().id == existing().id &&
        isTechOrAbove();

      allow delete: if isVerified() && isValidId(locationId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: adjustmentRequests/{requestId}
    // =========================================================================
    match /adjustmentRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isSignedIn();

      allow create: if isVerified() &&
        isValidId(requestId) &&
        isValidAdjustmentRequest(incoming()) &&
        incoming().requestId == requestId &&
        incoming().requestedByUid == request.auth.uid &&
        isTechOrAbove();

      // Approval always requires a reviewer different from the requester
      // (separation of duties), and the requester cannot change status themselves.
      allow update: if isVerified() &&
        isValidId(requestId) &&
        isValidAdjustmentRequest(incoming()) &&
        incoming().requestId == existing().requestId &&
        existing().status == 'PENDING' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status.isIn(['APPROVED', 'REJECTED']) &&
        isTechOrAbove() &&
        existing().requestedByUid != request.auth.uid;

      allow delete: if isVerified() && isValidId(requestId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: disposalRequests/{disposalId}
    // =========================================================================
    match /disposalRequests/{disposalId} {
      allow get: if isSignedIn() && isValidId(disposalId);
      allow list: if isSignedIn();

      allow create: if isVerified() &&
        isValidId(disposalId) &&
        isValidDisposalRequest(incoming()) &&
        incoming().disposalId == disposalId &&
        incoming().requestedByUid == request.auth.uid &&
        isActiveLabMember();

      allow update: if isVerified() &&
        isValidId(disposalId) &&
        isValidDisposalRequest(incoming()) &&
        incoming().disposalId == existing().disposalId &&
        existing().requestedByUid != request.auth.uid &&
        (isAdminOrProf() || isTechOrAbove());

      allow delete: if isVerified() && isValidId(disposalId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: purchaseRequests/{purchaseId}
    // =========================================================================
    match /purchaseRequests/{purchaseId} {
      allow get: if isSignedIn() && isValidId(purchaseId);
      allow list: if isSignedIn();

      allow create: if isVerified() &&
        isValidId(purchaseId) &&
        isValidPurchaseRequest(incoming()) &&
        incoming().purchaseId == purchaseId &&
        incoming().requestedByUid == request.auth.uid &&
        isActiveLabMember();

      allow update: if isVerified() &&
        isValidId(purchaseId) &&
        isValidPurchaseRequest(incoming()) &&
        incoming().purchaseId == existing().purchaseId &&
        existing().requestedByUid != request.auth.uid &&
        (isTechOrAbove() || isAdminOrProf());

      allow delete: if isVerified() && isValidId(purchaseId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: stockRuptureRequests/{ruptureId}
    // =========================================================================
    match /stockRuptureRequests/{ruptureId} {
      allow get: if isSignedIn() && isValidId(ruptureId);
      allow list: if isSignedIn();

      allow create: if isVerified() &&
        isValidId(ruptureId) &&
        isValidStockRuptureRequest(incoming()) &&
        incoming().ruptureId == ruptureId &&
        incoming().reportedByUid == request.auth.uid &&
        isActiveLabMember();

      // Merge additional reports (reportCount / reporters) and status transitions.
      allow update: if isVerified() &&
        isValidId(ruptureId) &&
        isValidStockRuptureRequest(incoming()) &&
        incoming().ruptureId == existing().ruptureId &&
        (
          (isActiveLabMember() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reportCount', 'reporters'])
          ) ||
          (isAdminOrProf() &&
            incoming().reportedByUid != request.auth.uid
          )
        );

      allow delete: if isVerified() && isValidId(ruptureId) && isAdmin();
    }

    // =========================================================================
    // COLLECTION: notifications/{notificationId}
    // =========================================================================
    match /notifications/{notificationId} {
      // Any active member may consult the notification feed (lab-internal
      // content, no credentials); mutation rights stay restricted.
      allow get, list: if isSignedIn() && isActiveLabMember();

      allow create: if isVerified() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().notificationId == notificationId &&
        incoming().createdByUserId == request.auth.uid &&
        isActiveLabMember();

      allow update: if isVerified() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().notificationId == existing().notificationId &&
        (
          (existing().recipientUserId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt'])) ||
          isTechOrAbove()
        );

      allow delete: if isVerified() && isValidId(notificationId) && (existing().recipientUserId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // COLLECTION: systemSettings/{settingId}
    // =========================================================================
    match /systemSettings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isSignedIn();

      allow create, update: if isVerified() && isValidId(settingId) && isTechOrAbove();
      allow delete: if isVerified() && isValidId(settingId) && isAdmin();
    }
  }
}
